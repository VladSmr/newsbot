# Sensitive data
.env
.env.*
*.env
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
.pytest_cache/

# Virtual environments
venv/
.venv/

# Database files (per-user state)
data/*.db
data/*.db.backup-*
data/*.db-*
# SQLite WAL (Write-Ahead Logging)
data/*.db-wal
data/*.db-shm

# JetBrains IDE
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db

# Temporary / untracked junk (m3-фикс: не попадают в коммит)
temp_*.txt