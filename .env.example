# ── Secrets для newsbot ───────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в git (.gitignore).

# ── Telegram ──────────────────────────────────────────────────────────
# Bot Token от @BotFather (например, 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=

# Привязанный chat_id (числовой ID вашего аккаунта в Telegram).
# Получите через: python -m newsbot --set-chat-id
# после запуска бота и нажатия /start в чате с ним.
# Опционально: можно задать через --set-chat-id (запишет в .env)
TELEGRAM_CHAT_ID=

# ── DeepSeek LLM ──────────────────────────────────────────────────────
# API-ключ с https://platform.deepseek.com/api_keys
# Без него бот работает в fallback-режиме (все новости доставляются без фильтрации)
DEEPSEEK_API_KEY=